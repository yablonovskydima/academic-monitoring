# Copy to .env (git-ignored) and fill in. Lines starting with "#" followed by a
# variable are optional and show the default the code uses.

# --- import-service ---
DB_USER_IMPORT_SERVICE=postgres1
DB_PASSWORD_IMPORT_SERVICE=change-me
DB_HOST_IMPORT_SERVICE=localhost
DB_PORT_IMPORT_SERVICE=5432
DB_NAME_IMPORT_SERVICE=import_service_db
IMPORT_SERVICE_URL=http://localhost:8001
IMPORT_SERVICE_PORT=8001

# --- ml-service ---
DB_USER_ML_SERVICE=postgres2
DB_PASSWORD_ML_SERVICE=change-me
DB_HOST_ML_SERVICE=localhost
DB_PORT_ML_SERVICE=5433
DB_NAME_ML_SERVICE=ml_service_db
ML_SERVICE_PORT=8002
KEEP_INACTIVE_MODEL_VERSIONS=5

# --- auth-service ---
DB_USER_AUTH_SERVICE=postgres3
DB_PASSWORD_AUTH_SERVICE=change-me
DB_HOST_AUTH_SERVICE=localhost
DB_PORT_AUTH_SERVICE=5434
DB_NAME_AUTH_SERVICE=auth_service_db
AUTH_SERVICE_PORT=8003

# Signing key shared by auth-service (signs) and auth-shared (verifies).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# First admin, created on startup if both are set (skipped otherwise). The
# password must have 8+ chars, upper and lower case, a digit and a symbol.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-Str0ng!
# INITIAL_ADMIN_FIRST_NAME=Admin
# INITIAL_ADMIN_LAST_NAME=Admin

# Email domains an admin may create or edit users with (empty = no check).
# ALLOWED_EMAIL_DOMAINS=pnu.edu.ua,cnu.edu.ua

# Rate limiting (per process, fixed window).
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_UNAUTHENTICATED_MAX=10
# RATE_LIMIT_AUTHENTICATED_MAX=60
# RATE_LIMIT_IP_MAX=300

# --- consumers of auth-shared's verified dependencies (e.g. the future BFF) ---
# Where to reach auth-service for /auth/introspect.
# AUTH_SERVICE_URL=http://localhost:8003
